// System info shown next to the ASCII art on the home tab (bin/home-art)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "color": { "1": "blue" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "cpu",
    "memory",
    {
      "type": "disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "battery",
    "uptime",
    "break",
    "colors"
  ]
}
