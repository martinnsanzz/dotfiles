#!/usr/bin/env bash
# Opens a claude or developer tab in tmux:
#
#   claude (Option+c)                   developer (Option+d)
#   ┌──────────────┬──────────────┐     ┌──────────────────────────────┐
#   │              │  yazi tree   │     │                              │
#   │   claude     │ (Enter→nvim) │     │  nvim . (project), the whole │
#   │  (project)   │     (~)      │     │  tab: its own file tree and  │
#   │              ├──────────────┤     │  terminal live inside nvim   │
#   │              │ fish terminal│     │                              │
#   │              │     (~)      │     │                              │
#   └──────────────┴──────────────┘     └──────────────────────────────┘
#
# Usage: dev claude|developer [dir]   open the tab in dir (default: current folder)
#        dev claude|developer --pick  choose a folder with fzf first
#        ... --pick --here   pick, then build the tab around the current pane
# DEV_SESSION=name adds the tab to that session instead of the current one.

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

kind=${1:-}
case $kind in
claude | developer) shift ;;
*)
	echo "usage: dev claude|developer [--pick] [--here] [dir]" >&2
	exit 1
	;;
esac

pick= here= dir=
for arg; do
	case $arg in
	--pick) pick=1 ;;
	--here) here=1 ;;
	*) dir=$arg ;;
	esac
done

# Folder browser: starts at ~/Projects, one level at a time.
# Enter opens the highlighted folder, → goes into it, ← goes back up.
ROOT="$HOME/Projects"

# One line per subfolder of $1; ▸ marks folders that have subfolders.
list() {
	local d
	[ "$1" = "$ROOT" ] && echo "~"
	[ "$1" != "$ROOT" ] && echo ". (this folder)"
	for d in "$1"/*/; do
		[ -d "$d" ] || continue
		d=${d%/}
		if [ -n "$(find "$d" -mindepth 1 -maxdepth 1 -type d -not -name '.*' -print -quit 2>/dev/null)" ]; then
			echo "${d##*/} ▸"
		else
			echo "${d##*/}"
		fi
	done
}

pick() {
	local cur=$ROOT out key sel target
	while :; do
		out=$(list "$cur" | fzf --expect=right,left --reverse --height=100% \
			--prompt="${cur/#$HOME/~}/ " --header='enter open · → into folder · ← back · esc cancel')
		# Esc / Ctrl+c: fzf exits 130 with no output.
		[ -n "$out" ] || return
		key=$(sed -n 1p <<<"$out")
		sel=$(sed -n 2p <<<"$out")
		sel=${sel% ▸}

		if [ "$key" = left ]; then
			[ "$cur" != "$ROOT" ] && cur=$(dirname "$cur")
			continue
		fi
		[ -n "$sel" ] || continue

		case $sel in
		"~") target=$HOME ;;
		". (this folder)") target=$cur ;;
		*) target=$cur/$sel ;;
		esac

		if [ "$key" = right ]; then
			# Only step into real subfolders, not ~ or the current folder.
			case $sel in "~" | ". (this folder)") ;; *) cur=$target ;; esac
			continue
		fi
		echo "$target"
		return
	done
}

if [ -n "$pick" ]; then
	dir=$(pick)
	# Cancelling the picker in --here mode still builds the tab, in home.
	if [ -z "$dir" ]; then
		[ -n "$here" ] || exit 0
		dir=$HOME
	fi
fi
dir=${dir:-$PWD}

# Tab name: claude:<project>, or just claude for home.
name=$kind
[ "$dir" != "$HOME" ] && name="$kind:$(basename "$dir")"

# The first pane: claude in a claude tab, nvim in a developer tab.
if [ -n "$here" ]; then
	main=$TMUX_PANE
	tmux rename-window -t "$main" "$name"
else
	main=$(tmux new-window ${DEV_SESSION:+-t "$DEV_SESSION:"} -n "$name" -c "$dir" -P -F '#{pane_id}')
fi

# Runs a program in the main pane. send-keys (instead of running it as the
# pane command) means quitting it drops back to a shell rather than closing
# the pane. In --here mode this pane's shell is still running us; the keys run
# once we exit.
start_main() {
	if [ -n "$here" ]; then
		tmux send-keys -t "$main" "cd $(printf %q "$dir") && clear && $1" Enter
	else
		tmux send-keys -t "$main" "$1" Enter
	fi
}

if [ "$kind" = claude ]; then
	# Only claude works in the chosen project; yazi and the terminal start in home.
	tree_pane=$(tmux split-window -h -l 50% -t "$main" -c "$HOME" -P -F '#{pane_id}')
	tmux split-window -v -l 40% -t "$tree_pane" -c "$HOME"
	start_main claude
	tmux send-keys -t "$tree_pane" 'yazi' Enter
	tmux select-pane -t "$main"
else
	# nvim's config opens its file tree and terminal for `nvim .` (nvim-config).
	start_main 'nvim .'
fi
