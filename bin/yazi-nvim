#!/usr/bin/env bash
# Opens a file in nvim in the yazi pane's place. Called by yazi's open-nvim plugin.
#
# yazi can run nvim inside its own pane, but handing the terminal over takes
# about 5 seconds in yazi 26. Instead nvim starts in a hidden tmux session and
# swaps into the tree's spot; quitting nvim swaps yazi back.
#
# Usage: yazi-nvim <file>   (run from inside the yazi pane)

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

file=$1
tree=$TMUX_PANE

width=$(tmux display -p -t "$tree" '#{pane_width}')
height=$(tmux display -p -t "$tree" '#{pane_height}')

# Arguments (not one string) so the default shell, fish, never parses them.
vim_pane=$(tmux new-session -d -P -F '#{pane_id}' -x "$width" -y "$height" \
	-c "$(dirname "$file")" \
	bash -c 'nvim -- "$1"; tmux swap-pane -s "$2" -t "$TMUX_PANE"; tmux select-pane -t "$2"' \
	_ "$file" "$tree")

tmux swap-pane -s "$vim_pane" -t "$tree"
tmux select-pane -t "$vim_pane"
