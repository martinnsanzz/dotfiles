#!/usr/bin/env bash
# Shows a short message centered in a tmux popup, then closes it (any key
# closes it sooner). Used to confirm config reloads (see tmux.conf).
#
# Usage: flash "message" [seconds]

# Inside the popup: draw the message and wait.
if [ "${1:-}" = --draw ]; then
	printf '\e[?25l\n   \e[1;34m%s\e[0m' "$2"
	read -rsn1 -t "$3" _
	exit 0
fi

msg=${1:-done}
secs=${2:-1.2}

if [ -z "${TMUX:-}" ]; then
	echo "$msg"
	exit
fi

# Arguments, not one string, so tmux's default shell (fish) never parses them.
exec tmux display-popup -E -w $((${#msg} + 8)) -h 5 -b rounded -S "fg=#89b4fa" \
	"$0" --draw "$msg" "$secs"
