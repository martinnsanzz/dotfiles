#!/usr/bin/env bash
# Shows a random ASCII art from the repo's art/ folder next to system info
# (fastfetch). Redraws when the pane is resized.
#   r = new random art    q = quit to the shell
# Add art by dropping a .txt file into art/.

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Follow the ~/.local/bin symlink back into the repo to find art/.
self=$(readlink "$0" || echo "$0")
ART_DIR=${ART_DIR:-$(cd "$(dirname "$self")/../art" && pwd)}

arts=("$ART_DIR"/*.txt)
art=""

draw() {
	clear
	if command -v fastfetch >/dev/null 2>&1; then
		fastfetch --logo "$art" --logo-type file
	else
		cat "$art"
	fi
}

new_art() {
	art=${arts[RANDOM % ${#arts[@]}]}
	draw
}

tput civis
trap 'tput cnorm' EXIT

new_art
size="$(tput cols)x$(tput lines)"
while true; do
	if read -rsn1 -t 1 key; then
		case $key in
			q) clear; break ;;
			r) new_art ;;
		esac
	fi
	now="$(tput cols)x$(tput lines)"
	if [ "$now" != "$size" ]; then
		size=$now
		draw
	fi
done
