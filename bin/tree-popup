#!/usr/bin/env bash
# The file tree popup (Option+e): yazi in the current pane's folder. Enter on
# a file closes yazi and opens the file in nvim in the same popup; quitting
# nvim closes the popup. Non-text files still open in their default app.

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

chosen=$(mktemp -t tree-popup)

# yazi 26 takes ~5s to hand the terminal back after choosing a file (see
# yazi-nvim), so stop it as soon as the path is written; nvim and the popup
# closing reset the terminal anyway.
(
	while [ ! -s "$chosen" ]; do sleep 0.05; done
	pkill -KILL -P $$ -x yazi
) &
watcher=$!
trap 'kill $watcher 2>/dev/null; rm -f "$chosen"' EXIT

YAZI_POPUP=1 yazi --chooser-file="$chosen" "$PWD"
stty sane 2>/dev/null

file=$(head -n 1 "$chosen")
[ -n "$file" ] || exit 0
case $(file -b --mime-type "$file") in
text/* | */json | */xml | */javascript | inode/x-empty) nvim -- "$file" ;;
*) open "$file" ;;
esac
