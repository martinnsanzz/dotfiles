#!/usr/bin/env bash
# Opens a file in nvim in the yazi pane's place. Called by yazi's open-vim plugin.
#
# yazi can run nvim inside its own pane, but handing the terminal over takes
# about 5 seconds in yazi 26. Instead nvim starts in a hidden tmux session and
# swaps into the tree's spot; quitting nvim swaps yazi back.
#
# In a developer tab (bin/dev) the file opens in the tab's editor pane instead.
#
# Usage: yazi-vim <file>   (run from inside the yazi pane)

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

file=$1
tree=$TMUX_PANE

# Developer tab: the pane marked @dev-editor (its value is the project folder).
editor= project=
while read -r id path; do
	[ -n "$path" ] && editor=$id project=$path && break
done < <(tmux list-panes -t "$tree" -F '#{pane_id} #{@dev-editor}')

if [ -n "$editor" ]; then
	# nvim already open there (see bin/dev-editor): send it the file. Unsaved
	# changes stay in the other tab.
	sock="${TMPDIR:-/tmp/}nvim-dev-${editor#%}.sock"
	if [ -S "$sock" ] && nvim --server "$sock" --remote-expr 1 >/dev/null 2>&1; then
		nvim --server "$sock" --remote "$file"
	else
		tmux respawn-pane -k -t "$editor" -c "$project" "$HOME/.local/bin/dev-editor" "$file"
	fi
	tmux select-pane -t "$editor"
	exit
fi

width=$(tmux display -p -t "$tree" '#{pane_width}')
height=$(tmux display -p -t "$tree" '#{pane_height}')

# Arguments (not one string) so the default shell, fish, never parses them.
vim_pane=$(tmux new-session -d -P -F '#{pane_id}' -x "$width" -y "$height" \
	-c "$(dirname "$file")" \
	bash -c 'nvim -- "$1"; tmux swap-pane -s "$2" -t "$TMUX_PANE"; tmux select-pane -t "$2"' \
	_ "$file" "$tree")

tmux swap-pane -s "$vim_pane" -t "$tree"
tmux select-pane -t "$vim_pane"
