#!/usr/bin/env bash
# Launched by Ghostty on every new window. Builds (or reattaches to) the
# tmux session "main" with just the home tab. Claude and developer tabs
# open on demand with Option+c / Option+d (see bin/dev).
#
#   1:home
#   ┌─────────┬───────────┬──────────────┐
#   │ sysinfo │  procs    │   terminal   │
#   │ cpu/mem │ apps and  │              │
#   │ + specs │ services  │              │
#   ├─────────┴───────────┴──────────────┤
#   │  animated art             ⌥ keys   │
#   │                                    │
#   └────────────────────────────────────┘
#
# Home can't be closed: Option+x / Option+w refuse (see tmux.conf) and a pane
# whose shell exits gets a fresh shell instead of disappearing.

# Apps launched from the Dock don't get Homebrew on PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

SESSION=main

# No tmux? Still give Ghostty a usable shell.
if ! command -v tmux >/dev/null 2>&1; then
	exec "$(command -v fish || echo /bin/zsh)" -l
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
	if [ -n "$(tmux list-clients -t "$SESSION" 2>/dev/null)" ]; then
		# Another Ghostty window is already attached: join the same tabs
		# through a grouped session that disappears when this window closes.
		exec tmux new-session -t "$SESSION" \; set-option destroy-unattached on
	fi
	exec tmux attach-session -t "$SESSION"
fi

cd "$HOME" || exit 1

# Home tab. The art pane is split off first so it spans the full width.
info_pane=$(tmux new-session -d -s "$SESSION" -n home -c "$HOME" -P -F '#{pane_id}')
art_pane=$(tmux split-window -v -l 50% -t "$info_pane" -c "$HOME" -P -F '#{pane_id}')
term_pane=$(tmux split-window -h -l 50% -t "$info_pane" -c "$HOME" -P -F '#{pane_id}')
procs_pane=$(tmux split-window -h -l 58% -t "$info_pane" -c "$HOME" -P -F '#{pane_id}')
tmux send-keys -t "$info_pane" 'sysinfo' Enter
tmux send-keys -t "$procs_pane" 'procs' Enter
tmux send-keys -t "$art_pane" 'home-art' Enter

# Lock home: tmux.conf's close keys check @locked, and dead panes respawn.
tmux set-option -w -t "$SESSION:home" @locked 1
tmux set-option -w -t "$SESSION:home" remain-on-exit on
tmux set-hook -w -t "$SESSION:home" pane-died respawn-pane

tmux select-pane -t "$term_pane"
exec tmux attach-session -t "$SESSION"
