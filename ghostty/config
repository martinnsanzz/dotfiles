# Ghostty config — reload with Cmd+Shift+R
# Every new window starts (or reattaches to) the tmux workspace.
command = shell:$HOME/.local/bin/workspace

# Appearance
theme = Catppuccin Mocha
font-size = 14
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

# Slightly see-through window with a blur of what's behind it
background-opacity = 0.85
background-blur = 20

# Let Option act as Alt so tmux's Alt+arrow pane switching works
macos-option-as-alt = true
# Ghostty maps Option+←/→ to word-jump by default; pass them to tmux instead
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

# Closing a window only detaches tmux, so no need to confirm
confirm-close-surface = false

# Reload, then send tmux a private key code so it pops up a confirmation
# (User0 in tmux.conf)
keybind = cmd+shift+r=reload_config
keybind = chain=text:\x1b[9001~
